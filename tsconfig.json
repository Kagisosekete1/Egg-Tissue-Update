{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true
  },
  "include": [
    "Scene.native.js",
    "app/**/*.js",
    "src/**/*.js",
    "expo-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "android",
    "artifacts",
    "dist"
  ]
}

